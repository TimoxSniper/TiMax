# ============================================
# TiMax Environment Variables
# ============================================

# ============================================
# SUPABASE (Datenbank)
# ============================================
# Gehe zu: https://supabase.com/dashboard → Dein Projekt → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://dein-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# CLERK (Authentifizierung)
# ============================================
# Gehe zu: https://dashboard.clerk.com → Dein Projekt → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/chat
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/chat

# ============================================
# N8N (Workflows)
# ============================================
# Webhook URLs aus deinem n8n
N8N_CHAT_WEBHOOK_URL=https://dein-n8n.com/webhook/timax-chat
N8N_UPLOAD_WEBHOOK_URL=https://dein-n8n.com/webhook/timax-upload

# ============================================
# OPTIONAL: OAuth Provider (für Clerk)
# ============================================
GOOGLE_CLIENT_ID=dein-google-client-id
GOOGLE_CLIENT_SECRET=dein-google-client-secret

# ============================================
# OPTIONAL: Monitoring
# ============================================
SENTRY_DSN=https://...sentry.io/...
NEXT_PUBLIC_SENTRY_DSN=https://...sentry.io/...

# ============================================
# UPSTASH REDIS (Rate Limiting)
# ============================================
# Gehe zu: https://console.upstash.com → Create Database → Copy credentials
# WICHTIG: Ohne diese Werte ist Rate Limiting deaktiviert!
UPSTASH_REDIS_REST_URL=https://dein-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=dein_upstash_token

# ============================================
# RATE LIMITING (Optional - hat Defaults)
# ============================================
# RATE_LIMIT_UPLOAD_MAX=5
# RATE_LIMIT_CHAT_MAX=20
# RATE_LIMIT_GENERATE_MAX=10
# RATE_LIMIT_DEFAULT_MAX=100

# ============================================
# GITHUB (für auto-pull.sh script)
# ============================================
GITHUB_USERNAME=dein_github_username
GITHUB_TOKEN=ghp_dein_token_hier
GITHUB_REPO_URL=github.com/username/repo.git

# ============================================
# UPLOAD KONFIGURATION
# ============================================
MAX_FILE_SIZE=104857600
ALLOWED_FILE_TYPES=audio/mpeg,audio/mp4,audio/wav,audio/m4a,video/mp4,video/webm
SESSION_STORAGE_KEY=rex_chat_sessions

# ============================================
# CRON JOB SECRET
# ============================================
# Generiere mit: openssl rand -hex 32
CRON_SECRET=dein_zufälliger_geheimer_string

# ============================================
# DEVELOPMENT
# ============================================
NODE_ENV=development
