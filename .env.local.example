# ============================================
# TiMax Environment Variables (Next.js)
# ============================================
# Kopiere diese Datei nach .env.local und fülle die Werte aus!
# cp .env.local.example .env.local
#
# WICHTIG: Qdrant, Google Gemini, ElevenLabs werden NUR in n8n 
# konfiguriert (unter Credentials), NICHT hier!

# ============================================
# SUPABASE (Datenbank)
# ============================================
# Gehe zu: https://supabase.com/dashboard → Dein Projekt → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://dein-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# CLERK (Authentifizierung)
# ============================================
# Gehe zu: https://dashboard.clerk.com → Dein Projekt → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Redirect nach Login/Registrierung (neue Variablen, ersetzt deprecated afterSignInUrl/afterSignUpUrl)
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/chat
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/chat

# ============================================
# N8N (Workflows)
# ============================================
# Webhook URLs aus deinem n8n - nach Import der Workflows aktivieren!
N8N_CHAT_WEBHOOK_URL=https://dein-n8n.app.n8n.cloud/webhook/timax-chat
N8N_UPLOAD_WEBHOOK_URL=https://dein-n8n.app.n8n.cloud/webhook/timax-upload

# ============================================
# UPLOAD KONFIGURATION
# ============================================
MAX_FILE_SIZE=104857600
ALLOWED_FILE_TYPES=audio/mpeg,audio/mp4,audio/wav,audio/m4a,video/mp4,video/webm
SESSION_STORAGE_KEY=rex_chat_sessions

# ============================================
# OPTIONAL: Monitoring (Sentry)
# ============================================
# SENTRY_DSN=https://...sentry.io/...
# NEXT_PUBLIC_SENTRY_DSN=https://...sentry.io/...

# ============================================
# OPTIONAL: Rate Limiting (Upstash Redis)
# ============================================
# Gehe zu: https://console.upstash.com → Create Database
# Ohne diese Werte ist Rate Limiting deaktiviert
# UPSTASH_REDIS_REST_URL=https://dein-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=dein_upstash_token

# ============================================
# OPTIONAL: GitHub (für auto-pull.sh script)
# ============================================
# GITHUB_USERNAME=dein_github_username
# GITHUB_TOKEN=ghp_dein_token_hier
# GITHUB_REPO_URL=github.com/username/repo.git

# ============================================
# DEVELOPMENT
# ============================================
NODE_ENV=development

# ============================================
# NUR IN N8N KONFIGURIEREN (NICHT HIER!)
# ============================================
# Diese Credentials werden in n8n unter "Credentials" eingetragen:
#
# 1. Supabase API:
#    - Host: dein-projekt.supabase.co (ohne https://)
#    - Service Role Key: (von Supabase Settings → API)
#
# 2. Google PaLM/Gemini API:
#    - API Key von: https://makersuite.google.com/app/apikey
#
# 3. ElevenLabs API:
#    - API Key von: https://elevenlabs.io → Profile → API Keys
#
# 4. Qdrant API:
#    - URL: https://xxx.eu-central.aws.cloud.qdrant.io:6333
#    - API Key von: https://cloud.qdrant.io → Cluster → Data Access Control
