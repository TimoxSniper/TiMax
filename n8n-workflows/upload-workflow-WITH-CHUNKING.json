      "id": "9d04e474-8c53-4980-b4a3-ef99d52c613f",
      "name": "Upload Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [14848, 6720],
      "webhookId": "timax-upload",
      "notes": "CORS aktiviert für Direct Client Upload"
    },
    {
      "parameters": {
        "jsCode": "// EXTRACT REQUEST DATA FROM CLIENT\n// Client sendet direkt zu n8n (nicht über Next.js API)\n\nconst input = $input.first();\nconst headers = input.json.headers || {};\nconst body = input.json.body || {};\n\n// Upload ID aus Header (REQUIRED)\nconst uploadId = headers['x-upload-id'] || body.upload_id;\nif (!uploadId) {\n  throw new Error('X-Upload-ID Header ist erforderlich');\n}\n\n// Dateiname aus Header\nconst fileName = headers['x-file-name'] || body.fileName || 'unbekannt';\n\n// User ID wird NICHT vom Client gesendet (Sicherheit!)\n// Stattdessen laden wir sie aus dem Supabase Upload-Eintrag\n\nreturn {\n  json: {\n    upload_id: uploadId,\n    file_name: fileName,\n    timestamp: new Date().toISOString()\n  },\n  binary: input.binary\n};"
      },
      "id": "4da03c5d-9b3a-44cc-89ef-5f343fecbe75",
      "name": "Extract Request Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [15072, 6720],
      "onError": "continueErrorOutput",
      "notes": "Extrahiert uploadId und fileName vom Client"
    },
    {
      "parameters": {
        "operation": "get",
        "tableId": "uploads",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "keyValue": "={{ $json.upload_id }}"
            }
          ]
        }
      },
      "id": "26171206-deee-4bf4-a965-c8920d5378d4",
      "name": "Get Upload Entry",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [15296, 6656],
      "credentials": {
        "supabaseApi": {
          "id": "8XMpaC9AdFcb3fSO",
          "name": "TiMax"
        }
      },
      "onError": "continueErrorOutput",
      "notes": "Lädt user_id aus Supabase mit Filter (FIXED!)"
    },
    {
      "parameters": {
        "jsCode": "// VALIDATE UPLOAD ENTRY AND EXTRACT USER ID\nconst input = $input.first().json;\nconst extractedData = $('Extract Request Data').first();\n\n// Prüfe ob Upload existiert\nif (!input || !input.user_id) {\n  throw new Error('Upload-Eintrag nicht gefunden oder ungültig');\n}\n\n// Prüfe ob Status valid ist (pending oder processing)\nif (input.status && !['pending', 'processing'].includes(input.status)) {\n  throw new Error(`Upload-Eintrag hat ungültigen Status: ${input.status}`);\n}\n\nreturn {\n  json: {\n    user_id: input.user_id,\n    upload_id: extractedData.json.upload_id,\n    file_name: extractedData.json.file_name || input.file_name,\n    timestamp: extractedData.json.timestamp\n  },\n  binary: extractedData.binary\n};"
      },
      "id": "099ff04f-d2d5-4b0f-b53d-d4bac332e27e",
      "name": "Validate Entry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [15520, 6576],
      "onError": "continueErrorOutput",
      "notes": "Validiert Upload und extrahiert user_id"
    },
