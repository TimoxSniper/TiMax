      "id": "7c7310c2-a9c4-4633-a127-0a872aff6f9e",
      "name": "Chat Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [-1120, -64],
      "webhookId": "timax-chat"
    },
    {
      "parameters": {
        "jsCode": "// Extract user_id, message, sessionId from webhook\nconst body = $input.first().json.body || {};\n\nconst userId = body.user_id || null;\nconst message = body.message || '';\nconst sessionId = body.sessionId || 'default';\nconst chatHistory = body.chatHistory || [];\nconst chatId = body.chat_id || null;\n\nif (!userId) {\n  throw new Error('User ID is required');\n}\n\nif (!message) {\n  throw new Error('Message is required');\n}\n\nreturn {\n  json: {\n    user_id: userId,\n    currentMessage: message,\n    sessionId: sessionId,\n    chat_id: chatId,\n    historyText: chatHistory.map((h, i) => `${i + 1}: ${h.content}`).join('\\n')\n  }\n};"
      },
      "id": "c766cb54-90c8-4791-b264-2570825a91cb",
      "name": "Extract Chat Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-752, -64]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.currentMessage }}",
        "options": {
          "systemMessage": "Du bist REX, ein Content-Erstellungs-Assistent. Du hast Zugriff auf die Wissensdatenbank des Users mit seinen transkribierten Videos.\\n\\n=== CHAT-VERLAUF ===\\n{{ $json.historyText || 'Keine vorherigen Nachrichten.' }}\\n\\n=== WICHTIG ===\\n- Du siehst nur Inhalte dieses Users\\n- Nutze das search_knowledge_base Tool für relevante Informationen\\n- Antworte auf Deutsch\\n- Beziehe dich auf vorherige Nachrichten im Chat-Verlauf",
          "returnIntermediateSteps": false
        }
      },
      "id": "5beefbc8-b357-4b1a-8c2a-c74bc13b3a25",
      "name": "REX Chat Agent",
