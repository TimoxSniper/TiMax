{
  "name": "TiMax Chat Workflow (Multi-User + Supabase)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "timax-chat",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "chat-webhook",
      "name": "Chat Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [100, 200],
      "webhookId": "timax-chat"
    },
    {
      "parameters": {
        "jsCode": "// Extract user_id, message, sessionId from webhook\nconst body = $input.first().json.body || {};\n\nconst userId = body.user_id || null;\nconst message = body.message || '';\nconst sessionId = body.sessionId || 'default';\nconst chatHistory = body.chatHistory || [];\nconst chatId = body.chat_id || null;  // Supabase chat_id\n\nif (!userId) {\n  throw new Error('User ID is required');\n}\n\nif (!message) {\n  throw new Error('Message is required');\n}\n\nreturn {\n  json: {\n    user_id: userId,\n    currentMessage: message,\n    sessionId: sessionId,\n    chat_id: chatId,\n    historyText: chatHistory.map((h, i) => `${i + 1}: ${h.content}`).join('\\n')\n  }\n};"
      },
      "id": "extract-chat-data",
      "name": "Extract Chat Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [300, 200]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.currentMessage }}",
        "options": {
          "systemMessage": "Du bist REX, ein Content-Erstellungs-Assistent. Du hast Zugriff auf die Wissensdatenbank des Users mit seinen transkribierten Videos.\\n\\n=== CHAT-VERLAUF ===\\n{{ $json.historyText || 'Keine vorherigen Nachrichten.' }}\\n\\n=== WICHTIG ===\\n- Du siehst nur Inhalte dieses Users\\n- Nutze das search_knowledge_base Tool für relevante Informationen\\n- Antworte auf Deutsch\\n- Beziehe dich auf vorherige Nachrichten im Chat-Verlauf",
          "returnIntermediateSteps": false
        }
      },
      "id": "chat-agent",
      "name": "REX Chat Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3,
      "position": [500, 200]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "gemini-chat-model",
      "name": "Google Gemini Chat",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [500, 400],
      "credentials": {
        "googlePalmApi": {
          "id": "YOUR_GEMINI_CRED_ID",
          "name": "Google Gemini"
        }
      }
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "gemini-embeddings",
      "name": "Generate Search Embeddings",
      "type": "@n8n/n8n-nodes-langchain.embeddingsGoogleGemini",
      "typeVersion": 1,
      "position": [700, 400],
      "credentials": {
        "googlePalmApi": {
          "id": "YOUR_GEMINI_CRED_ID",
          "name": "Google Gemini"
        }
      }
    },
    {
      "parameters": {
        "mode": "retrieve-as-tool",
        "toolDescription": "Durchsuche die Wissensdatenbank des Users. Filtert automatisch nach user_id.",
        "qdrantCollection": {"__rl": true, "mode": "id", "value": "timax_knowledge_base"},
        "topK": 8,
        "options": {
          "filter": {
            "must": [{"key": "user_id", "match": {"value": "={{ $('Extract Chat Data').item.json.user_id }}"}}]
          }
        }
      },
      "id": "qdrant-retrieve",
      "name": "Search Knowledge Base",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreQdrant",
      "typeVersion": 1.3,
      "position": [700, 600],
      "credentials": {
        "qdrantApi": {
          "id": "YOUR_QDRANT_CRED_ID",
          "name": "Qdrant"
        }
      }
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Extract Chat Data').item.json.sessionId }}",
        "contextWindowLength": 10000
      },
      "id": "chat-memory",
      "name": "Chat Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [700, 100]
    },
    {
      "parameters": {
        "jsCode": "// Format agent output with fallback\nconst item = $input.first().json;\nlet output = item.output || item.text || item.message?.content || 'Keine Antwort generiert.';\n\nreturn {\n  json: {\n    output: output,\n    user_id: $('Extract Chat Data').item.json.user_id,\n    chat_id: $('Extract Chat Data').item.json.chat_id\n  }\n};"
      },
      "id": "format-output",
      "name": "Format Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 200]
    },
    {
      "parameters": {
        "operation": "insert",
        "tableId": "messages",
        "options": {},
        "dataMode": "define",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldName": "chat_id",
              "fieldValue": "={{ $('Format Output').item.json.chat_id }}"
            },
            {
              "fieldName": "role",
              "fieldValue": "=assistant"
            },
            {
              "fieldName": "content",
              "fieldValue": "={{ $('Format Output').item.json.output }}"
            }
          ]
        }
      },
      "id": "save-message",
      "name": "Save Message to Supabase",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1100, 200],
      "credentials": {
        "supabaseApi": {
          "id": "YOUR_SUPABASE_CRED_ID",
          "name": "Supabase"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "allIncomingItems",
        "options": {}
      },
      "id": "send-response",
      "name": "Send Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [1300, 200]
    }
  ],
  "connections": {
    "Chat Webhook": {"main": [[{"node": "Extract Chat Data", "type": "main", "index": 0}]]},
    "Extract Chat Data": {"main": [[{"node": "REX Chat Agent", "type": "main", "index": 0}]]},
    "REX Chat Agent": {"main": [[{"node": "Format Output", "type": "main", "index": 0}]]},
    "Format Output": {"main": [[{"node": "Save Message to Supabase", "type": "main", "index": 0}]]},
    "Save Message to Supabase": {"main": [[{"node": "Send Response", "type": "main", "index": 0}]]},
    "Google Gemini Chat": {"ai_languageModel": [[{"node": "REX Chat Agent", "type": "ai_languageModel", "index": 0}]]},
    "Generate Search Embeddings": {"ai_embedding": [[{"node": "Search Knowledge Base", "type": "ai_embedding", "index": 0}]]},
    "Search Knowledge Base": {"ai_tool": [[{"node": "REX Chat Agent", "type": "ai_tool", "index": 0}]]},
    "Chat Memory": {"ai_memory": [[{"node": "REX Chat Agent", "type": "ai_memory", "index": 0}]]}
  },
  "settings": {"executionOrder": "v1"},
  "staticData": null,
  "tags": [],
  "pinData": {}
}