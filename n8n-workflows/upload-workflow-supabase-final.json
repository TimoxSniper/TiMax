      },
      "id": "bb8b43cb-2749-4fcf-8f14-e3b4fc58c589",
      "name": "Upload Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [-688, -160],
      "webhookId": "timax-upload"
    },
    {
      "parameters": {
        "jsCode": "// Extract user_id from webhook headers or body\nconst headers = $input.first().json.headers || {};\nconst body = $input.first().json.body || {};\n\n// Try to get user_id from various sources\nlet userId = headers['x-user-id'] || body.user_id || null;\n\nif (!userId) {\n  throw new Error('User ID is required - please provide x-user-id header or user_id in body');\n}\n\nreturn {\n  json: {\n    user_id: userId,\n    file: body.file || null,\n    fileName: body.fileName || 'unknown',\n    metadata: body.metadata || {}\n  }\n};"
      },
      "id": "40b3fced-7600-4690-8f5e-a1c45740a9ed",
      "name": "Extract User ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-464, -160]
    },
    {
      "parameters": {
        "resource": "speech",
        "operation": "speechToText",
        "file": "={{ $json.file }}",
        "additionalOptions": {},
        "requestOptions": {}
      },
      "id": "af50172d-1e2f-4e7e-b8d4-aa7f5cfab562",
      "name": "ElevenLabs Speech To Text",
      "type": "@elevenlabs/n8n-nodes-elevenlabs.elevenLabs",
      "typeVersion": 1,
      "position": [-240, -160],
      "credentials": {
        "elevenLabsApi": {
          "id": "e6MMDFDQ1dbDxpvE",
          "name": "ElevenLabs account"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "content",
              "name": "content",
              "value": "={{ $json.text }}",
              "type": "string"
            },
            {
              "id": "user_id",
              "name": "user_id",
              "value": "={{ $('Extract User ID').item.json.user_id }}",
              "type": "string"
            },
            {
              "id": "fileName",
              "name": "fileName",
              "value": "={{ $('Extract User ID').item.json.fileName }}",
              "type": "string"
            },
            {
              "id": "uploadedAt",
              "name": "uploadedAt",
