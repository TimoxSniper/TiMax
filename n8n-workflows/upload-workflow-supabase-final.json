            }
          ]
        },
        "options": {}
      },
      "id": "ebe0e45b-7354-4b98-83bf-6d8ee6a547e1",
      "name": "Format Content Metadata",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-48, -160]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Analysiere diesen Inhalt und extrahiere Metadaten im JSON-Format:\n\nInhalt: {{ $json.content.substring(0, 4000) }}\nDateiname: {{ $json.fileName }}\n\nLiefere:\n{\n  \"topics\": [\"tag1\", \"tag2\"],\n  \"intention\": \"bildung|motivation|argumentation|beispiel|geschichte\",\n  \"platform_suitability\": [\"reel_hook\", \"linkedin_post\", \"twitter_thread\"],\n  \"tone\": \"enthusiastisch|kritisch|sachlich|inspirierend\",\n  \"content_quality\": 7,\n  \"key_quotes\": [\"zitat1\", \"zitat2\"]\n}\n\nNUR JSON, keine Erklärung.",
        "batching": {}
      },
      "id": "1bef4aa2-29b6-4571-8ff7-05c0869c618d",
      "name": "Extract Content Metatags",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [128, -160]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "95a137c0-9083-49b1-80f2-8658be062811",
      "name": "Google Gemini",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [128, 96],
      "credentials": {
        "googlePalmApi": {
          "id": "BWPxLiVPTdHxDSZp",
          "name": "Google Gemini(PaLM) Api account 3"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item.json;\nconst preparedData = $('Format Content Metadata').item.json;\n\nlet metadata = {};\ntry {\n  const cleaned = (item.output || item.text || '').replace(/```json\\n?|```\\n?/g, '').trim();\n  metadata = JSON.parse(cleaned);\n} catch (e) {\n  metadata = { topics: [], intention: 'general', platform_suitability: [], tone: 'neutral', content_quality: 5, key_quotes: [] };\n}\n\nreturn {\n  json: {\n    content: preparedData.content,\n    user_id: preparedData.user_id,\n    fileName: preparedData.fileName,\n    uploadedAt: preparedData.uploadedAt,\n    ...metadata\n  }\n};"
      },
      "id": "3363b6c5-9e0b-49ef-b532-54b2d8b7aaca",
      "name": "Combine AI Metadata",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [416, -160]
    },
    {
      "parameters": {
        "operation": "insert",
        "tableId": "uploads",
        "options": {},
        "dataMode": "define",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldName": "user_id",
              "fieldValue": "={{ $('Combine AI Metadata').item.json.user_id }}"
            },
            {
              "fieldName": "file_name",
              "fieldValue": "={{ $('Combine AI Metadata').item.json.fileName }}"
            },
            {
              "fieldName": "transcript",
              "fieldValue": "={{ $('Combine AI Metadata').item.json.content }}"
            },
            {
              "fieldName": "status",
              "fieldValue": "=completed"
            },
            {
              "fieldName": "metadata",
              "fieldValue": "={{ JSON.stringify({ topics: $json.topics, intention: $json.intention, tone: $json.tone, content_quality: $json.content_quality, key_quotes: $json.key_quotes }) }}"
            }
          ]
        }
      },
