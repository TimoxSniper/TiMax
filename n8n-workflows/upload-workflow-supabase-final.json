{
  "name": "TiMax Upload Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "timax-upload",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-upload",
      "name": "Upload Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [-1200, 0],
      "webhookId": "timax-upload"
    },
    {
      "parameters": {
        "jsCode": "// EXTRACT REQUEST DATA\n// Daten kommen als Headers von Next.js API + Binary File\n\nconst input = $input.first();\nconst headers = input.json.headers || {};\nconst body = input.json.body || {};\n\n// User ID aus Header (Clerk User ID)\nconst userId = headers['x-user-id'] || body.user_id;\nif (!userId) {\n  throw new Error('X-User-ID Header ist erforderlich');\n}\n\n// Upload ID aus Header (Supabase Upload ID für Update)\nconst uploadId = headers['x-upload-id'] || body.upload_id;\nif (!uploadId) {\n  throw new Error('X-Upload-ID Header ist erforderlich');\n}\n\n// Dateiname\nconst fileName = headers['x-file-name'] || body.fileName || 'unbekannt';\n\nreturn {\n  json: {\n    user_id: userId,\n    upload_id: uploadId,\n    file_name: fileName,\n    timestamp: new Date().toISOString()\n  },\n  binary: input.binary\n};"
      },
      "id": "extract-data",
      "name": "Extract Request Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-960, 0],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "resource": "speech",
        "operation": "speechToText",
        "additionalOptions": {
          "languageCode": "de"
        }
      },
      "id": "elevenlabs-stt",
      "name": "ElevenLabs STT",
      "type": "@elevenlabs/n8n-nodes-elevenlabs.elevenLabs",
      "typeVersion": 1,
      "position": [-720, 0],
      "credentials": {
        "elevenLabsApi": {
          "id": "CREDENTIAL_ID",
          "name": "ElevenLabs API"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// PREPARE TRANSCRIPT\nconst input = $input.first().json;\nconst extractedData = $('Extract Request Data').item.json;\n\n// Transkript extrahieren\nlet transcript = '';\n\nif (input.text) {\n  transcript = input.text;\n} else if (input.words && Array.isArray(input.words)) {\n  transcript = input.words.map(w => w.text || w).join(' ');\n} else {\n  // Fallback\n  transcript = JSON.stringify(input);\n}\n\nif (!transcript || transcript.trim().length < 5) {\n  throw new Error('Transkription fehlgeschlagen: Kein Text erkannt');\n}\n\nreturn {\n  json: {\n    user_id: extractedData.user_id,\n    upload_id: extractedData.upload_id,\n    file_name: extractedData.file_name,\n    transcript: transcript.trim(),\n    transcript_length: transcript.length,\n    timestamp: extractedData.timestamp\n  }\n};"
      },
      "id": "prepare-transcript",
      "name": "Prepare Transcript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-480, 0],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Analysiere diesen transkribierten Text und extrahiere Metadaten.\n\n=== TRANSKRIPT ===\n{{ $json.transcript.substring(0, 5000) }}\n\n=== DATEINAME ===\n{{ $json.file_name }}\n\n=== AUFGABE ===\nGib ein JSON-Objekt zurück mit:\n\n{\n  \"topics\": [\"thema1\", \"thema2\", \"thema3\"],\n  \"intention\": \"bildung|motivation|argumentation|beispiel|geschichte|unterhaltung\",\n  \"tone\": \"enthusiastisch|kritisch|sachlich|inspirierend|humorvoll\",\n  \"content_quality\": 7,\n  \"key_quotes\": [\"wichtiges Zitat\"],\n  \"summary\": \"Kurze Zusammenfassung in 2 Sätzen\"\n}\n\nRegeln:\n- topics: 3-5 relevante Schlagwörter\n- content_quality: 1-10\n- key_quotes: 1-3 bemerkenswerte Zitate\n- summary: Max 200 Zeichen\n\nAntworte NUR mit dem JSON, ohne Erklärung."
      },
      "id": "ai-metadata",
      "name": "AI Metadata",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [-240, 0],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "model": "gemini-1.5-flash",
        "options": {
          "temperature": 0.3
        }
      },
      "id": "gemini-metadata",
      "name": "Google Gemini",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [-240, 240],
      "credentials": {
        "googlePalmApi": {
          "id": "CREDENTIAL_ID",
          "name": "Google Gemini API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// COMBINE DATA\nconst input = $input.first().json;\nconst preparedData = $('Prepare Transcript').item.json;\n\n// Default Metadaten\nlet metadata = {\n  topics: [],\n  intention: 'general',\n  tone: 'neutral',\n  content_quality: 5,\n  key_quotes: [],\n  summary: ''\n};\n\ntry {\n  let jsonText = input.output || input.text || '';\n  \n  // Markdown Code-Blöcke entfernen\n  jsonText = jsonText.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n  \n  // JSON extrahieren\n  const jsonMatch = jsonText.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    const parsed = JSON.parse(jsonMatch[0]);\n    metadata = { ...metadata, ...parsed };\n  }\n} catch (e) {\n  // Bei Fehler: Default-Werte verwenden\n  console.log('Metadata parsing failed, using defaults');\n}\n\n// Validierung\nmetadata.topics = Array.isArray(metadata.topics) ? metadata.topics.slice(0, 10) : [];\nmetadata.content_quality = Math.min(10, Math.max(1, parseInt(metadata.content_quality) || 5));\nmetadata.key_quotes = Array.isArray(metadata.key_quotes) ? metadata.key_quotes.slice(0, 5) : [];\n\nreturn {\n  json: {\n    user_id: preparedData.user_id,\n    upload_id: preparedData.upload_id,\n    file_name: preparedData.file_name,\n    transcript: preparedData.transcript,\n    transcript_length: preparedData.transcript_length,\n    metadata: metadata,\n    timestamp: preparedData.timestamp\n  }\n};"
      },
      "id": "combine-data",
      "name": "Combine Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [0, 0],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "uploads",
        "filterType": "string",
        "filterString": "=id=eq.{{ $json.upload_id }}",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldName": "transcript",
              "fieldValue": "={{ $json.transcript }}"
            },
            {
              "fieldName": "status",
              "fieldValue": "completed"
            },
            {
              "fieldName": "metadata",
              "fieldValue": "={{ JSON.stringify($json.metadata) }}"
            }
          ]
        }
      },
      "id": "supabase-update",
      "name": "Update Supabase",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [240, 0],
      "credentials": {
        "supabaseApi": {
          "id": "CREDENTIAL_ID",
          "name": "Supabase API"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsonMode": "expressionData",
        "jsonData": "={{ $('Combine Data').item.json.transcript }}",
        "options": {
          "metadata": {
            "metadataValues": [
              {
                "name": "user_id",
                "value": "={{ $('Combine Data').item.json.user_id }}"
              },
              {
                "name": "upload_id",
                "value": "={{ $('Combine Data').item.json.upload_id }}"
              },
              {
                "name": "file_name",
                "value": "={{ $('Combine Data').item.json.file_name }}"
              },
              {
                "name": "topics",
                "value": "={{ JSON.stringify($('Combine Data').item.json.metadata.topics || []) }}"
              },
              {
                "name": "intention",
                "value": "={{ $('Combine Data').item.json.metadata.intention || 'general' }}"
              },
              {
                "name": "tone",
                "value": "={{ $('Combine Data').item.json.metadata.tone || 'neutral' }}"
              },
              {
                "name": "uploaded_at",
                "value": "={{ $('Combine Data').item.json.timestamp }}"
              }
            ]
          }
        }
      },
      "id": "prepare-document",
      "name": "Prepare for Qdrant",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1.1,
      "position": [240, 240]
    },
    {
      "parameters": {
        "mode": "insert",
        "qdrantCollection": {
          "__rl": true,
          "mode": "id",
          "value": "timax_knowledge_base"
        },
        "options": {}
      },
      "id": "qdrant-insert",
      "name": "Insert Qdrant",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreQdrant",
      "typeVersion": 1.3,
      "position": [480, 0],
      "credentials": {
        "qdrantApi": {
          "id": "CREDENTIAL_ID",
          "name": "Qdrant API"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "model": "text-embedding-004"
      },
      "id": "gemini-embeddings",
      "name": "Embeddings",
      "type": "@n8n/n8n-nodes-langchain.embeddingsGoogleGemini",
      "typeVersion": 1,
      "position": [480, 240],
      "credentials": {
        "googlePalmApi": {
          "id": "CREDENTIAL_ID",
          "name": "Google Gemini API"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, upload_id: $('Combine Data').item.json.upload_id, transcript_length: $('Combine Data').item.json.transcript_length, status: 'completed' }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "success-response",
      "name": "Success Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [720, 0]
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "uploads",
        "filterType": "string",
        "filterString": "=id=eq.{{ $('Extract Request Data').item.json.upload_id }}",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldName": "status",
              "fieldValue": "failed"
            },
            {
              "fieldName": "error_message",
              "fieldValue": "={{ $json.error?.message || 'Fehler bei der Verarbeitung' }}"
            }
          ]
        }
      },
      "id": "mark-failed",
      "name": "Mark Failed",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [480, 400],
      "credentials": {
        "supabaseApi": {
          "id": "CREDENTIAL_ID",
          "name": "Supabase API"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: false, error: $json.error?.message || 'Verarbeitung fehlgeschlagen', upload_id: $('Extract Request Data').item.json?.upload_id || null }) }}",
        "options": {
          "responseCode": 500
        }
      },
      "id": "error-response",
      "name": "Error Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [720, 400]
    }
  ],
  "connections": {
