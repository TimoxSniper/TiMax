                "value": "Content-Type, X-Upload-ID, X-File-Name"
              }
            ]
          }
        }
      },
      "id": "success-response",
      "name": "Success Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [1120, 0],
      "notes": "Mit CORS Headers"
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "uploads",
        "filterType": "string",
        "filterString": "=id=eq.{{ $('Extract Request Data').item.json.upload_id }}",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldName": "status",
              "fieldValue": "failed"
            },
            {
              "fieldName": "error_message",
              "fieldValue": "={{ $json.error?.message || 'Fehler bei der Verarbeitung' }}"
            }
          ]
        }
      },
      "id": "mark-failed",
      "name": "Mark Failed",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [880, 480],
      "credentials": {
