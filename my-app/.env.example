# n8n Webhook URLs (mit Auth)
N8N_CHAT_WEBHOOK_URL=https://your-n8n-instance.com/webhook/chat-endpoint
N8N_UPLOAD_WEBHOOK_URL=https://your-n8n-instance.com/webhook/upload-endpoint

# n8n API (optional, für MCP Server)
N8N_API_URL=http://localhost:5678
N8N_API_KEY=your-n8n-api-key

# Clerk Auth (ERFORDERLICH für Multi-User)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/chat
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/chat

# Supabase (ERFORDERLICH für Multi-User)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sentry (für Phase 1.1)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Analytics (für Phase 1.2)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=your-domain.com
# oder
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Sentry Error Tracking (für Phase 1.1)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# SENTRY_ORG=your-org
# SENTRY_PROJECT=your-project
